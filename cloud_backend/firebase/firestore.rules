rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOrganiser() {
      return request.auth != null && request.auth.token.ps22_role == 'ORGANISER';
    }

    function isTeamManager(teamId) {
      return request.auth != null &&
             request.auth.token.ps22_role == 'TEAM_MANAGER' &&
             request.auth.token.ps22_team_id == teamId;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isOrganiser();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow write: if isOrganiser();
    }

    match /fixtures/{fixtureId} {
      allow read: if true;
      allow write: if isOrganiser();
    }

    match /sessions/{sessionId} {
      allow read, write: if true;
    }

    match /venues/{venueId} {
      allow read: if true;
      allow write: if true;
    }

    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /match_scoreboards/{matchId} {
      allow read, write: if true;
    }
  }
}
